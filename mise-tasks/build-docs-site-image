#!/usr/bin/env bash
#MISE description="Build the static docs container image"
#MISE alias="bdsi"
#MISE sources=["docker/build/docs-site.Dockerfile", "docs/public/**/*"]

set -euo pipefail
. "$(dirname "$0")/lib.sh"

require_docker

image_name="${KSBH_DOCS_SITE_IMAGE:-ksbh-docs-site:local}"
cache_repo="${KSBH_DOCS_SITE_CACHE_REPO:-}"
push_image="${KSBH_DOCS_SITE_PUSH:-false}"
load_image="${KSBH_DOCS_SITE_LOAD:-true}"

build_args=(
  buildx
  build
  --file docker/build/docs-site.Dockerfile
  --tag "${image_name}"
)

if [ -n "${cache_repo}" ]; then
  build_args+=(--cache-from "type=registry,ref=${cache_repo}")
  build_args+=(--cache-to "type=registry,ref=${cache_repo},mode=max,image-manifest=true,oci-mediatypes=true")
fi

if [ "${push_image}" = "true" ]; then
  build_args+=(--push)
elif [ "${load_image}" = "true" ]; then
  build_args+=(--load)
fi

docker "${build_args[@]}" .
