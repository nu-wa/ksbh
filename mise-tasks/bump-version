#!/usr/bin/env bash
#MISE description="Bump Rust workspace and Helm chart versions"
#USAGE flag "--rust <version>" help="Set all Rust workspace package versions"
#USAGE flag "--helm <version>" help="Set Helm chart version"
#USAGE flag "--helm-app <version>" help="Set Helm chart appVersion"
#USAGE flag "--all <version>" help="Set Rust, Helm chart version, and Helm appVersion"

set -euo pipefail

rust_version="${usage_rust:-}"
helm_version="${usage_helm:-}"
helm_app_version="${usage_helm_app:-}"
all_version="${usage_all:-}"

usage() {
  cat >&2 <<'EOF'
usage:
  mise run bump-version -- --rust <version>
  mise run bump-version -- --helm <version>
  mise run bump-version -- --helm-app <version>
  mise run bump-version -- --all <version>

examples:
  mise run bump-version -- --all 0.2.0
  mise run bump-version -- --rust 0.2.0 --helm-app 0.2.0
  mise run bump-version -- --helm 0.1.2
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --rust)
      rust_version="${2:-}"
      shift 2
      ;;
    --helm)
      helm_version="${2:-}"
      shift 2
      ;;
    --helm-app)
      helm_app_version="${2:-}"
      shift 2
      ;;
    --all)
      all_version="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [ -n "${all_version}" ]; then
  if [ -n "${rust_version}" ] || [ -n "${helm_version}" ] || [ -n "${helm_app_version}" ]; then
    echo "--all cannot be combined with --rust, --helm, or --helm-app" >&2
    exit 1
  fi
  rust_version="${all_version}"
  helm_version="${all_version}"
  helm_app_version="${all_version}"
fi

if [ -z "${rust_version}" ] && [ -z "${helm_version}" ] && [ -z "${helm_app_version}" ]; then
  usage
  exit 1
fi

validate_version() {
  local label="$1"
  local version="$2"

  if ! printf '%s' "${version}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([-.+][0-9A-Za-z.-]+)?$'; then
    echo "invalid ${label} version: ${version}" >&2
    exit 1
  fi
}

[ -z "${rust_version}" ] || validate_version "Rust" "${rust_version}"
[ -z "${helm_version}" ] || validate_version "Helm chart" "${helm_version}"
[ -z "${helm_app_version}" ] || validate_version "Helm app" "${helm_app_version}"

repo_root="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P
)"
cd "${repo_root}"

if [ -n "${rust_version}" ]; then
  while IFS= read -r cargo_toml; do
    perl -0pi -e 's/^(version = ")[^"]+(")/${1}'"${rust_version}"'${2}/m' "${cargo_toml}"

    package_name="$(
      awk -F '"' '/^name = "/ { print $2; exit }' "${cargo_toml}"
    )"
    if [ -n "${package_name}" ]; then
      perl -0pi -e 's/(\[\[package\]\]\nname = "\Q'"${package_name}"'\E"\nversion = ")[^"]+(")/${1}'"${rust_version}"'${2}/g' crates/Cargo.lock
    fi
  done < <(
    find crates -mindepth 2 -name Cargo.toml -print | sort
  )

  echo "bumped Rust workspace packages to ${rust_version}"
fi

if [ -n "${helm_version}" ]; then
  perl -0pi -e 's/^(version:\s*).+/${1}'"${helm_version}"'/m' charts/ksbh/Chart.yaml
  echo "bumped Helm chart version to ${helm_version}"
fi

if [ -n "${helm_app_version}" ]; then
  perl -0pi -e 's/^(appVersion:\s*).+/${1}"'"${helm_app_version}"'"/m' charts/ksbh/Chart.yaml
  echo "bumped Helm appVersion to ${helm_app_version}"
fi

echo
echo "next:"
echo "  git diff -- crates charts/ksbh/Chart.yaml"
echo "  git add crates/Cargo.toml crates/Cargo.lock crates/**/Cargo.toml charts/ksbh/Chart.yaml"
if [ -n "${rust_version}" ]; then
  echo "  git commit -m 'release: v${rust_version}'"
  echo "  git tag v${rust_version}"
else
  echo "  git commit -m 'chore: bump chart version'"
fi
echo "  git push origin HEAD --follow-tags"
