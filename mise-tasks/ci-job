#!/usr/bin/env bash
#MISE description="Run one CI job locally inside the configured act image"
#USAGE arg "<job>" help="One of build-rust, test-binary, test-k8s, build-docs, helm-artifacts"

set -euo pipefail

script_dir="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P
)"

exec bash "${script_dir}/scripts/ci/ci-job.sh" "$@"
