#!/usr/bin/env bash
#MISE description="Build the static Helm repo container image"
#MISE alias="bcsi"
#MISE sources=["docker/build/charts-site.Dockerfile", "dist/helm-repo/**/*"]

set -euo pipefail
. "$(dirname "$0")/lib.sh"

require_docker

image_name="${KSBH_CHARTS_SITE_IMAGE:-ksbh-charts-site:local}"
cache_repo="${KSBH_CHARTS_SITE_CACHE_REPO:-}"
push_image="${KSBH_CHARTS_SITE_PUSH:-false}"
load_image="${KSBH_CHARTS_SITE_LOAD:-true}"

build_args=(
  buildx
  build
  --file docker/build/charts-site.Dockerfile
  --tag "${image_name}"
)

if [ -n "${cache_repo}" ]; then
  build_args+=(--cache-from "type=registry,ref=${cache_repo}")
  build_args+=(--cache-to "type=registry,ref=${cache_repo},mode=max,image-manifest=true,oci-mediatypes=true")
fi

if [ "${push_image}" = "true" ]; then
  build_args+=(--push)
elif [ "${load_image}" = "true" ]; then
  build_args+=(--load)
fi

docker "${build_args[@]}" .
