#!/usr/bin/env bash
#MISE description="Build shared UI CSS and docs CSS"
set -euo pipefail

export PATH="${PWD}/docs/node_modules/.bin:${PATH}"

if ! command -v tailwindcss >/dev/null 2>&1; then
  echo "tailwindcss is not available; install docs npm dependencies or run inside act-rust-wasm-node" >&2
  exit 1
fi

(
  cd docs
  deno task build:css
)
