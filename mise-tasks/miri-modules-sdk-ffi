#!/usr/bin/env bash
#MISE description="Run Miri against the ksbh-modules-sdk FFI smoke test"
#MISE alias="miri-ffi"
#MISE sources=["crates/Cargo.toml", "crates/Cargo.lock", "crates/ksbh-core/**", "crates/ksbh-modules-sdk/**"]

set -euo pipefail
. "$(dirname "$0")/lib.sh"

miri_run_root="${KSBH_MIRI_RUN_ROOT:-/tmp/ksbh-miri-$(date +%s)-$$}"
rustup_home="${KSBH_MIRI_RUSTUP_HOME:-${miri_run_root}/rustup}"
cargo_home="${KSBH_MIRI_CARGO_HOME:-${miri_run_root}/cargo}"
miri_target_dir="${KSBH_MIRI_TARGET_DIR:-${miri_run_root}/target}"
mkdir -p "${rustup_home}" "${cargo_home}" "${miri_target_dir}"

# Keep Miri isolated from normal cargo state, but allow optional persistent local caches.
export RUSTUP_HOME="${rustup_home}"
export CARGO_HOME="${cargo_home}"
export CARGO_TARGET_DIR="${miri_target_dir}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
export PATH="${CARGO_HOME}/bin:${PATH}"
unset RUSTFLAGS
unset CARGO_ENCODED_RUSTFLAGS

if [ ! -x "${CARGO_HOME}/bin/rustup" ]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | bash -s -- -y --default-toolchain none
fi

rustup toolchain install nightly --profile minimal --component miri --component rust-src
cargo +nightly miri setup
cargo +nightly miri test --manifest-path crates/Cargo.toml -p ksbh-modules-sdk --test ffi_miri -- --nocapture --test-threads=1
