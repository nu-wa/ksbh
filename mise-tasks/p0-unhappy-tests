#!/usr/bin/env bash
#MISE description="Run targeted unhappy-path and property regression tests"
#MISE tools={rust="1.92.0"}

set -euo pipefail
. "$(dirname "$0")/lib.sh"

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"
deps_dir="$repo_root/crates/target/debug/deps"

if [ "${KSBH_CI_USE_PREBUILT:-false}" = "true" ]; then
  core_libtest_bin="$(resolve_test_binary "${deps_dir}" "ksbh_core")"

  if [ -z "${core_libtest_bin}" ]; then
    echo "prebuilt ksbh_core test binary is missing in ${deps_dir}" >&2
    exit 1
  fi

  chmod +x "${core_libtest_bin}" || true
  "${core_libtest_bin}" reputation --nocapture --test-threads=1
  "${core_libtest_bin}" runtime_signals --nocapture --test-threads=1
  "${core_libtest_bin}" signal_callbacks_read_live_runtime_state --nocapture --test-threads=1
else
  cargo test --manifest-path crates/Cargo.toml -p ksbh-core reputation
  cargo test --manifest-path crates/Cargo.toml -p ksbh-core runtime_signals
  cargo test --manifest-path crates/Cargo.toml -p ksbh-core signal_callbacks_read_live_runtime_state
fi
