#!/usr/bin/env bash
#MISE description="Run FFI dynamic module smoke tests"
#MISE tools={rust="1.92.0"}

set -euo pipefail
. "$(dirname "$0")/lib.sh"

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"
deps_dir="$repo_root/crates/target/debug/deps"

export KSBH_MODULE_DIR="$repo_root/crates/target/debug"
export KSBH_DYNAMIC_SMOKE_LOOPS="${KSBH_DYNAMIC_SMOKE_LOOPS:-500}"

if [ "${KSBH_CI_USE_PREBUILT:-false}" = "true" ]; then
  smoke_bin="$(resolve_test_binary "${deps_dir}" "dynamic_modules_smoke")"
  "${smoke_bin}" --nocapture --test-threads=1
else
  cargo test --manifest-path crates/Cargo.toml -p ksbh-core --test dynamic_modules_smoke \
    -- --nocapture --test-threads=1
fi
